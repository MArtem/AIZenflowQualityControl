{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MArtem/AIZenflowQualityControl/policies/check-catalog.schema.json",
  "title": "AIZenflow Deterministic Check Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "catalogVersion", "checks"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "catalogVersion": { "$ref": "#/$defs/boundedString" },
    "checks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": { "$ref": "#/$defs/check" }
    }
  },
  "$defs": {
    "boundedString": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "\\S"
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "scope", "severity", "applicability", "remediation", "fixture", "implementation"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^QC\\.[A-Z0-9][A-Z0-9_.-]*$",
          "maxLength": 128
        },
        "scope": { "$ref": "#/$defs/boundedString" },
        "severity": { "enum": ["block", "warning", "review"] },
        "applicability": { "enum": ["always", "profile", "project-contract", "manual"] },
        "remediation": { "$ref": "#/$defs/boundedString" },
        "fixture": {
          "type": "object",
          "additionalProperties": false,
          "required": ["positive", "negative"],
          "properties": {
            "positive": { "$ref": "#/$defs/boundedString" },
            "negative": { "$ref": "#/$defs/boundedString" }
          }
        },
        "implementation": { "enum": ["implemented", "staged", "review-candidate"] }
      }
    }
  }
}
