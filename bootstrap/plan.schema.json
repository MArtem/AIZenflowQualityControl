{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MArtem/AIZenflowQualityControl/bootstrap/plan.schema.json",
  "title": "AIZenflow Bootstrap Inventory Plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "entries"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "entries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "source", "destination", "kind"],
        "properties": {
          "id": { "$ref": "#/$defs/pathString" },
          "source": { "$ref": "#/$defs/repositoryRelativePath" },
          "destination": { "$ref": "#/$defs/repositoryRelativePath" },
          "kind": { "enum": ["exact", "overlay"] }
        }
      }
    }
  },
  "$defs": {
    "pathString": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?!\\s*$).+"
    },
    "repositoryRelativePath": {
      "$ref": "#/$defs/pathString",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//).+"
    }
  }
}
