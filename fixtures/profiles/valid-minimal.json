{
  "mode": "controlled",
  "permissions": {
    "githubExecution": "manual",
    "localTestExecution": "ask",
    "performanceOrInstruments": "ask",
    "simulatorOrDevice": "ask",
    "testCreation": "ask",
    "testModification": "ask",
    "uiTests": "ask"
  },
  "project": {
    "kind": "xcodeproj",
    "path": "ExampleProject.xcodeproj"
