{
  "$id": "https://github.com/MArtem/AIZenflowQualityControl/schemas/project-profile.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": { "schemaVersion": { "const": 1 } },
        "required": ["schemaVersion"]
      },
      "then": {
        "required": ["scheme"],
        "properties": {
          "sandbox": { "$ref": "#/$defs/absoluteSandbox" }
        },
        "not": {
          "anyOf": [
            { "required": ["engine"] },
            { "required": ["xcode"] },
            { "required": ["applicability"] }
          ]
        }
      }
    },
    {
      "if": {
        "properties": { "schemaVersion": { "const": 2 } },
        "required": ["schemaVersion"]
      },
      "then": {
        "required": ["engine", "xcode", "applicability"],
        "properties": {
          "sandbox": { "$ref": "#/$defs/portableSandbox" }
        },
        "not": { "required": ["scheme"] }
      }
    }
  ],
  "properties": {
    "applicability": {
      "items": { "$ref": "#/$defs/capabilityApplicability" },
      "maxItems": 8,
      "minItems": 8,
      "type": "array"
    },
    "engine": { "$ref": "#/$defs/enginePin" },
    "mode": {
      "enum": [
        "prototype",
        "controlled",
        "production"
      ]
    },
    "permissions": {
      "additionalProperties": false,
      "properties": {
        "githubExecution": {
          "enum": [
            "off",
            "manual"
          ]
        },
        "localTestExecution": {
          "$ref": "#/$defs/permissionDecision"
        },
        "performanceOrInstruments": {
          "$ref": "#/$defs/permissionDecision"
        },
        "simulatorOrDevice": {
          "$ref": "#/$defs/permissionDecision"
        },
        "testCreation": {
          "$ref": "#/$defs/permissionDecision"
        },
        "testModification": {
          "$ref": "#/$defs/permissionDecision"
        },
        "uiTests": {
          "$ref": "#/$defs/permissionDecision"
        }
      },
      "required": [
        "testCreation",
        "testModification",
        "localTestExecution",
        "githubExecution",
        "uiTests",
        "simulatorOrDevice",
        "performanceOrInstruments"
      ],
      "type": "object"
    },
    "project": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "xcodeproj",
            "xcworkspace"
          ]
        },
        "path": {
          "$ref": "#/$defs/relativePath"
        }
      },
      "required": [
        "kind",
        "path"
      ],
      "type": "object"
    },
    "sandbox": {
      "type": "object"
    },
    "schemaVersion": {
      "enum": [1, 2]
    },
    "scheme": {
      "minLength": 1,
      "pattern": "\\S",
      "type": "string"
    },
    "sourcePaths": {
      "items": {
        "$ref": "#/$defs/relativePath"
      },
      "maxItems": 256,
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "xcode": {
      "additionalProperties": false,
      "properties": {
        "schemes": {
          "items": { "$ref": "#/$defs/xcodeScheme" },
          "maxItems": 32,
          "minItems": 1,
          "type": "array"
        },
        "sourceMembership": {
          "additionalProperties": false,
          "properties": {
            "authority": { "const": "xcode-build-graph" }
          },
          "required": ["authority"],
          "type": "object"
        }
      },
      "required": ["sourceMembership", "schemes"],
      "type": "object"
    }
  },
  "required": [
    "schemaVersion",
    "project",
    "sourcePaths",
    "mode",
    "permissions",
    "sandbox"
  ],
  "title": "AIZenflow Quality Control Project Profile",
  "type": "object",
  "$defs": {
    "absoluteSandbox": {
      "additionalProperties": false,
      "properties": {
        "cache": { "$ref": "#/$defs/absolutePath" },
        "root": { "$ref": "#/$defs/absolutePath" }
      },
      "required": ["root", "cache"],
      "type": "object"
    },
    "capabilityApplicability": {
      "additionalProperties": false,
      "properties": {
        "capability": {
          "enum": [
            "tests",
            "snapshotTests",
            "uiTests",
            "archiveSigning",
            "featureFlags",
            "privacy",
            "observability",
            "platformCapabilities"
          ]
        },
        "owner": { "$ref": "#/$defs/nonEmptyString" },
        "reason": { "$ref": "#/$defs/nonEmptyString" },
        "revisitCondition": { "$ref": "#/$defs/nonEmptyString" },
        "status": {
          "enum": ["applicable", "notApplicable", "deferred"]
        }
      },
      "required": ["capability", "status", "reason", "owner", "revisitCondition"],
      "type": "object"
    },
    "enginePin": {
      "additionalProperties": false,
      "properties": {
        "revision": {
          "pattern": "^[0-9a-f]{40}$",
          "type": "string"
        },
        "version": { "$ref": "#/$defs/nonEmptyString" }
      },
      "required": ["version", "revision"],
      "type": "object"
    },
    "nonEmptyString": {
      "minLength": 1,
      "pattern": "\\S",
      "type": "string"
    },
    "absolutePath": {
      "minLength": 1,
      "pattern": "^/",
      "type": "string"
    },
    "permissionDecision": {
      "enum": [
        "allow",
        "deny",
        "ask"
      ]
    },
    "portableSandbox": {
      "additionalProperties": false,
      "properties": {
        "cache": { "$ref": "#/$defs/portableSandboxPath" },
        "root": { "$ref": "#/$defs/portableSandboxPath" }
      },
      "required": ["root", "cache"],
      "type": "object"
    },
    "portableSandboxPath": {
      "allOf": [
        { "$ref": "#/$defs/relativePath" },
        {
          "not": {
            "pattern": "(?:^|/)\\.{1,2}(?:/|$)|//|/$"
          }
        }
      ]
    },
    "relativePath": {
      "allOf": [
        {
          "minLength": 1,
          "pattern": "\\S",
          "type": "string"
        },
        {
          "not": {
            "pattern": "^(?:/|~)|(?:^|/)\\.\\.(?:/|$)"
          }
        }
      ]
    },
    "stringSelection": {
      "items": { "$ref": "#/$defs/nonEmptyString" },
      "maxItems": 64,
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "xcodeScheme": {
      "additionalProperties": false,
      "properties": {
        "configurations": { "$ref": "#/$defs/stringSelection" },
        "destinations": { "$ref": "#/$defs/stringSelection" },
        "name": { "$ref": "#/$defs/nonEmptyString" },
        "targets": { "$ref": "#/$defs/stringSelection" },
        "testPlans": {
          "items": { "$ref": "#/$defs/relativePath" },
          "maxItems": 64,
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": ["name", "targets", "configurations", "destinations", "testPlans"],
      "type": "object"
    }
  }
}
