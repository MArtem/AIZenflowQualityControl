{
  "$id": "https://github.com/MArtem/AIZenflowQualityControl/schemas/evidence-production-context.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AIZenflow Quality Control Evidence Production Context",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "sourceRepository": { "$ref": "quality-evidence.schema.json#/$defs/nonEmptyString" },
    "sourceRevision": { "$ref": "quality-evidence.schema.json#/$defs/gitRevision" },
    "engineVersion": { "$ref": "quality-evidence.schema.json#/$defs/nonEmptyString" },
    "engineRevision": { "$ref": "quality-evidence.schema.json#/$defs/gitRevision" },
    "toolchain": { "$ref": "quality-evidence.schema.json#/properties/toolchain" },
    "commands": { "$ref": "quality-evidence.schema.json#/properties/commands" },
    "gates": { "$ref": "quality-evidence.schema.json#/properties/gates" },
    "testCounts": { "$ref": "quality-evidence.schema.json#/properties/testCounts" },
    "reviewRevision": { "$ref": "quality-evidence.schema.json#/$defs/gitRevision" },
    "residualRisks": { "$ref": "quality-evidence.schema.json#/properties/residualRisks" }
  },
  "required": [
    "schemaVersion",
    "sourceRepository",
    "sourceRevision",
    "engineVersion",
    "engineRevision",
    "toolchain",
    "commands",
    "gates",
    "residualRisks"
  ]
}
