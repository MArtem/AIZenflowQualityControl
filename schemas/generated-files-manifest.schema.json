{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aizenflow.dev/schemas/generated-files-manifest.schema.json",
  "title": "Generated file ownership manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "files"],
  "properties": {
    "schemaVersion": {"const": 1},
    "files": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "generator", "version", "sha256"],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "pattern": "^[^/~\\\\].*$"
          },
          "generator": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._/-]{1,128}$"
          },
          "version": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._+/-]{0,127}$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    }
  }
}
