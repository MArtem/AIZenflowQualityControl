{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MArtem/AIZenflowQualityControl/schemas/static-evidence-result.schema.json",
  "title": "AIZenflow Static Evidence Execution Result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "command", "status", "report", "evidence", "verification"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "command": { "const": "static-evidence" },
    "status": { "enum": ["PASS", "FAIL", "BLOCKED"] },
    "report": { "$ref": "#/$defs/report" },
    "evidence": { "oneOf": [{ "type": "null" }, { "$ref": "quality-evidence.schema.json" }] },
    "verification": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/verification" }] }
  },
  "oneOf": [
    {
      "properties": {
        "status": { "const": "PASS" },
        "report": {
          "allOf": [
            { "properties": { "status": { "const": "PASS" } } },
            { "properties": { "checks": { "items": { "properties": { "status": { "const": "PASS" } } } } } }
          ]
        },
        "evidence": {
          "allOf": [
            { "$ref": "quality-evidence.schema.json" },
            {
              "properties": {
                "claimedVerdict": { "const": "READY" },
                "testCounts": false,
                "reviewRevision": false,
                "artifacts": { "maxItems": 0 },
                "residualRisks": { "maxItems": 0 },
                "commands": {
                  "minItems": 1,
                  "maxItems": 1,
                  "items": {
                    "properties": {
                      "id": { "const": "static" },
                      "exitCode": { "const": 0 },
                      "actions": { "maxItems": 0 },
                      "authorization": { "const": "NOT_REQUIRED" }
                    }
                  }
                },
                "gates": {
                  "minItems": 1,
                  "maxItems": 1,
                  "items": {
                    "properties": {
                      "id": { "const": "QC.STATIC" },
                      "status": { "const": "PASS" },
                      "commandID": { "const": "static" },
                      "actions": { "maxItems": 0 }
                    }
                  }
                }
              }
            }
          ]
        },
        "verification": { "allOf": [{ "$ref": "#/$defs/verification" }, { "properties": { "verdict": { "const": "READY" }, "issues": { "maxItems": 0 } } }] }
      }
    },
    {
      "properties": {
        "status": { "const": "FAIL" },
        "report": {
          "allOf": [
            { "properties": { "status": { "const": "FAIL" } } },
            { "properties": { "checks": { "contains": { "properties": { "status": { "const": "FAIL" } } }, "minContains": 1 } } }
          ]
        },
        "evidence": { "allOf": [{ "$ref": "quality-evidence.schema.json" }, { "properties": { "claimedVerdict": { "const": "NOT_READY" } } }] },
        "verification": { "allOf": [{ "$ref": "#/$defs/verification" }, { "properties": { "verdict": { "const": "NOT_READY" }, "issues": { "maxItems": 0 } } }] }
      }
    },
    {
      "properties": {
        "status": { "const": "BLOCKED" },
        "report": {
          "allOf": [
            { "properties": { "status": { "const": "BLOCKED" } } },
            {
              "properties": {
                "checks": {
                  "not": { "contains": { "properties": { "status": { "const": "FAIL" } } } }
                }
              }
            },
            { "properties": { "checks": { "contains": { "properties": { "status": { "const": "BLOCKED" } } }, "minContains": 1 } } }
          ]
        },
        "evidence": { "type": "null" },
        "verification": { "type": "null" }
      }
    },
    {
      "properties": {
        "status": { "const": "BLOCKED" },
        "report": {
          "allOf": [
            { "properties": { "status": { "const": "BLOCKED" } } },
            {
              "properties": {
                "checks": {
                  "not": { "contains": { "properties": { "status": { "const": "FAIL" } } } }
                }
              }
            },
            { "properties": { "checks": { "contains": { "properties": { "status": { "const": "BLOCKED" } } }, "minContains": 1 } } }
          ]
        },
        "evidence": { "allOf": [{ "$ref": "quality-evidence.schema.json" }, { "properties": { "claimedVerdict": { "const": "BLOCKED" } } }] },
        "verification": { "allOf": [{ "$ref": "#/$defs/verification" }, { "properties": { "verdict": { "const": "BLOCKED" }, "issues": { "maxItems": 0 } } }] }
      }
    }
  ],
  "$defs": {
    "report": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "command", "status", "checks"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "command": { "const": "static" },
        "status": { "enum": ["PASS", "FAIL", "BLOCKED"] },
        "checks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2048,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "status", "message"],
            "properties": {
              "id": { "type": "string", "minLength": 1, "maxLength": 1024 },
              "status": { "enum": ["PASS", "FAIL", "BLOCKED"] },
              "message": { "type": "string", "minLength": 1, "maxLength": 1024 },
              "path": { "type": "string", "minLength": 1, "maxLength": 1024 }
            }
          }
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verdict", "issues"],
      "properties": {
        "verdict": { "enum": ["READY", "READY_WITH_ACCEPTED_RISK", "NEEDS_OWNER_DECISION", "NOT_READY", "BLOCKED", "BYPASSED"] },
        "issues": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["code", "message"],
            "properties": {
              "code": { "type": "string", "minLength": 1, "maxLength": 1024 },
              "message": { "type": "string", "minLength": 1, "maxLength": 1024 }
            }
          }
        }
      }
    }
  }
}
