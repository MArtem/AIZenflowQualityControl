{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aizenflow.dev/schemas/deterministic-check-result.schema.json",
  "title": "Deterministic check result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "command", "status", "sourceRevision", "checks"],
  "properties": {
    "schemaVersion": {"const": 1},
    "command": {"const": "deterministic-checks"},
    "status": {"enum": ["PASS", "FAIL", "BLOCKED"]},
    "sourceRevision": {"type": "string", "pattern": "^(?:[0-9a-f]{40})?$"},
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "sha256"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 1024},
        "version": {"type": "string", "minLength": 1, "maxLength": 128},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^(?!/|~)(?!.*\\\\)(?!.*//)(?!.*(?:^|/)\\.\\.(?:/|$)).+"
        },
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baselineRevision", "policyPath", "policySHA256"],
      "properties": {
        "baselineRevision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "policyPath": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^(?!/|~)(?!.*\\\\)(?!.*//)(?!.*(?:^|/)\\.\\.(?:/|$)).+"
        },
        "policySHA256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "checks": {
      "type": "array", "minItems": 1, "maxItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "status", "message"],
        "properties": {
          "id": {"enum": ["QC.SECRETS.TRACKED", "QC.TODO.OWNER", "QC.GENERATED.OWNERSHIP", "QC.DEPENDENCY.LOCK_DRIFT", "QC.LOCALIZATION.CATALOG", "QC.RESOURCES.ASSETS", "QC.FORMAT.SWIFTFORMAT", "QC.CONFIGURATION.SIGNING"]},
          "status": {"enum": ["PASS", "FAIL", "BLOCKED"]},
          "message": {"type": "string", "minLength": 1, "maxLength": 1024},
          "findings": {
            "type": "array", "maxItems": 64,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["path", "message"],
              "properties": {
                "path": {"type": "string", "minLength": 1, "maxLength": 1024},
                "message": {"type": "string", "minLength": 1, "maxLength": 1024}
              }
            }
          }
        }
      }
    }
  }
}
