{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MArtem/AIZenflowQualityControl/schemas/mode-execution-result.schema.json",
  "title": "AIZenflow Quality Mode Execution Result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "command", "mode", "status", "steps"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "command": { "const": "mode-execute" },
    "mode": { "enum": ["static", "build", "build-and-tests", "full"] },
    "status": { "$ref": "#/$defs/gateStatus" },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": { "$ref": "#/$defs/step" }
    }
  },
  "$defs": {
    "boundedString": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "\\S"
    },
    "gateStatus": {
      "enum": [
        "PASS",
        "FAIL",
        "BLOCKED",
        "NOT_APPLICABLE",
        "NOT_RUN_BY_USER_DECISION",
        "SKIPPED"
      ]
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "command", "status", "message", "report", "evidence", "verification"],
      "properties": {
        "id": { "$ref": "#/$defs/boundedString" },
        "command": { "$ref": "#/$defs/boundedString" },
        "status": { "$ref": "#/$defs/gateStatus" },
        "message": { "$ref": "#/$defs/boundedString" },
        "report": { "type": ["object", "null"] },
        "evidence": { "type": ["object", "null"] },
        "verification": { "type": ["object", "null"] }
      }
    }
  }
}
